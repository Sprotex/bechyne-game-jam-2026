[resource]
script = ExtResource("1")
messages = PackedStringArray("TETY stará pračka? A něco v ní břinčí.", "Vysypu kapsy těch hadrů, přehrabovat se v tom nebudu.", "Nějakej dement zase zapomněl vyndat klíč z kapsy.", "…", "Kdo tu pračku zapnul? TETA musí být zpátky.", "Ale kde je? Vždyť jsme ji nikdo z rodiny dlouho neviděli.", "Divný.", "No ale na tomhle smradu už to tu nevymyslim.")
