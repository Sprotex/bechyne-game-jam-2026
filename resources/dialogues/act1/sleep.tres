[gd_resource type="Resource" script_class="StoryText" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/core/story_text.gd" id="1"]

[resource]
script = ExtResource("1")
messages = PackedStringArray("Už se stmívá a TETA furt nikde. Asi zase někde bloudí jako vždycky.", "Ráda se procházela po přírodě a naslouchala lesu.", "…", "Byla trochu divná.", "No asi si půjdu schrupnout, mám za sebou dlouhou cestu.", "Na TETU nemá cenu čekat, stejně se ze svého toulání po přírodě vracela často až ráno.", "Snad až se vzbudím tak tu už bude.", "Cho mi mi mi mi…")
